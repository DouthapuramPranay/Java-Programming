    "String=\"zcbbcd\"\n",
    "palindrome=[]\n",
    "for i in range(0,len(String)+1):\n",
    "    for j in range(0,len(String)+1):\n",
    "        if String[i:j]!=\"\":\n",
    "            if String[i:j]==String[i:j][::-1]:\n",
    "                palindrome.append(String[i:j])\n",
    "a=[]\n",
    "for i in palindrome:\n",
    "    a.append(len(i))\n",
    "print(max(a))g"
   ]
